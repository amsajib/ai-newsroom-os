NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
# Use a pooled Neon connection for normal app traffic.
DATABASE_URL=replace-with-pooled-neon-connection
# Use direct/unpooled connection for migrations only.
DATABASE_URL_UNPOOLED=replace-with-direct-neon-connection
# Configure a real secret manager before production.
SECRET_STORE_MODE=local-dev-only

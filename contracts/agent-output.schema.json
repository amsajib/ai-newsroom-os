{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Newsroom OS Agent Output",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "task_id",
    "agent_id",
    "run_id",
    "status",
    "created_at",
    "input_refs",
    "data",
    "claims",
    "warnings",
    "errors",
    "validation",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed",
        "needs_human"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "classification",
          "evidence",
          "source_url",
          "source_reliability",
          "verification_status",
          "reason"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_ref",
                "excerpt",
                "relation"
              ],
              "properties": {
                "source_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "excerpt": {
                  "type": "string"
                },
                "relation": {
                  "enum": [
                    "supports",
                    "contradicts",
                    "context_only",
                    "none"
                  ]
                }
              }
            }
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "source_reliability": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "verification_status": {
            "enum": [
              "VERIFIED",
              "PARTIALLY_VERIFIED",
              "UNVERIFIED",
              "CONTRADICTED"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "schema_valid",
        "required_fields_present",
        "blocking_issues"
      ],
      "properties": {
        "schema_valid": {
          "type": "boolean"
        },
        "required_fields_present": {
          "type": "boolean"
        },
        "blocking_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "next_agent_id",
        "required_input_refs",
        "handoff_status"
      ],
      "properties": {
        "next_agent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_input_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "handoff_status": {
          "enum": [
            "pending",
            "ready",
            "blocked",
            "not_required"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}